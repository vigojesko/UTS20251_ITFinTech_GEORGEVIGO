# MongoDB Connection String (ubah dengan .env lokal kamu saja)
MONGODB_URL=mongodb+srv://<username>:<password>@paymentgateway.mongodb.net/uts_payment?retryWrites=true&w=majority&appName=paymentgateway

# Xendit (gunakan placeholder agar tidak dianggap secret)
XENDIT_SECRET_KEY=xnd_development_XXXXXXXXXXXXXXX
XENDIT_CALLBACK_TOKEN=XXXXXXXXXXXXXXX

# Next.js public base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# JWT Secret (gunakan random string sendiri lokal)
JWT_SECRET=your_jwt_secret_here

# Twilio (gunakan placeholder agar tidak ditolak push)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_WHATSAPP_NUMBER=+14155238886